[Unit]
Description=TicTacTest Java console (loopback only)
After=network.target
ConditionPathExists=/etc/tictactest/release.env

[Service]
Type=simple
User=tictactest
Group=tictactest
StateDirectory=tictactest
StateDirectoryMode=0755
Environment=TICTACTEST_ENV=lab
EnvironmentFile=/etc/tictactest/release.env
ExecStartPre=/usr/bin/python3 -B /opt/tictactest/current/runtime/backend-version.py ${JAR_PATH} /var/lib/tictactest/version.txt
ExecStart=/usr/local/bin/ttyd -W -O -i 127.0.0.1 -p 7681 -m 4 -b /console /usr/bin/java -Xmx64m -jar ${JAR_PATH}
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
# libwebsockets needs netlink/getifaddrs to resolve its loopback binding.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
