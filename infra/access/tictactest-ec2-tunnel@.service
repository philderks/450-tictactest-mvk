[Unit]
Description=Private SSH tunnel to the TicTacTest EC2 web service (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=%i
Group=%i
EnvironmentFile=/etc/tictactest-tunnel/%i.env
ExecStart=/usr/bin/ssh -NT -i ${SSH_KEY} -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=${KNOWN_HOSTS} -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -L 127.0.0.1:18080:127.0.0.1:8080 ec2-user@${EC2_HOST}
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
UMask=0077

[Install]
WantedBy=multi-user.target
