# Nur Beispielwerte, keine Zugangsdaten. Fuer die eigene Umgebung pruefen und
# nach terraform.tfvars kopieren; die lokale Kopie wird von Git ignoriert.
aws_region        = "us-east-1"
availability_zone = "us-east-1a"
instance_name     = "tictactest-iac"
instance_type     = "t3.micro"

# In diesem Lab geprueftes Amazon-Linux-2023-Image. Verfuegbarkeit vor Plan pruefen.
ami_id = "ami-00f43ee0e98d52529"

ssh_public_key_path = "~/.ssh/tictactest_lab_ed25519.pub"
# Dokumentationsadresse: unbedingt durch die tatsaechliche SSH-Client-IP ersetzen.
ssh_allowed_cidr = "192.0.2.1/32"
